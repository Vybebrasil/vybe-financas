{
  "name": "vybe-financas",
  "version": "0.0.1",
  "description": "Vybe Finanças — gestão financeira (React + Supabase)",
  "author": "Vybe Brasil",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "recurring:run": "node scripts/run-monthly-recurring.mjs",
    "recurring:deploy": "npx supabase@latest functions deploy monthly-recurring --project-ref nmqpfvfusyqenexckkvr",
    "recurring:invoke": "node scripts/invoke-monthly-recurring.mjs",
    "recurring:secret": "powershell -ExecutionPolicy Bypass -File scripts/set-cron-secret.ps1",
    "whatsapp:deploy": "npx supabase@latest functions deploy send-whatsapp --project-ref nmqpfvfusyqenexckkvr",
    "whatsapp:secrets": "powershell -ExecutionPolicy Bypass -File scripts/set-whatsapp-secrets.ps1",
    "contracts:template": "node scripts/generate-vybe-contract-template.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.91.0",
    "docx": "^9.7.0",
    "docxtemplater": "^3.68.7",
    "dotenv": "^16.3.1",
    "file-saver": "^2.0.5",
    "lucide-react": "^0.562.0",
    "pizzip": "^3.2.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@jridgewell/sourcemap-codec": "^1.5.0",
    "@playwright/test": "^1.52.0",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.1.3",
    "vite": "^6.2.0",
    "vitest": "^3.2.4"
  }
}
