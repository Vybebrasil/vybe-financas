# Copie para .env.e2e.local para rodar o teste autenticado (opcional):
# cp .env.e2e.example .env.e2e.local

# Credenciais de um usuário de teste no Supabase
E2E_EMAIL=seu-usuario-teste@exemplo.com
E2E_PASSWORD=sua-senha-teste

# Opcional: sobrescreve o projeto (senão usa .env.local)
# VITE_SUPABASE_URL=https://seu-projeto.supabase.co
# VITE_SUPABASE_ANON_KEY=sua-anon-key

# GitHub Actions (Settings → Secrets):
# E2E_EMAIL, E2E_PASSWORD, VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY
